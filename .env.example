# Copy to .env.local to configure the weather data source.
#
# open-meteo (default): free for non-commercial use, no key needed.
# openweather: needs VITE_OPENWEATHER_API_KEY (https://home.openweathermap.org/api_keys).
VITE_WEATHER_PROVIDER=open-meteo

# NOTE: VITE_* variables are bundled into the client JavaScript. This key is NOT secret
# once deployed — restrict/monitor it in your OpenWeather account.
VITE_OPENWEATHER_API_KEY=
